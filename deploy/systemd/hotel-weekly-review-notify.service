[Unit]
Description=Send Validated Hotel Weekly Reviews
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ctrip-monitor
WorkingDirectory=/opt/hotel-ota-monitor
Environment=TZ=Asia/Shanghai
EnvironmentFile=/var/lib/ctrip-monitor/.hotel_agent/db.env
EnvironmentFile=/var/lib/ctrip-monitor/.hotel_agent/webhook.env
TimeoutStartSec=5min
ExecStart=/usr/bin/flock -n /tmp/hotel-weekly-review.lock /opt/hotel-ota-monitor/.venv/bin/python /opt/hotel-ota-monitor/main.py weekly-review --auto-last-week --hotel-key all --no-dry-run --notify-existing --no-admin-overview
