[Unit]
Description=Discover future Shanghai events through Qwen native web search
After=network-online.target hotel-event-intelligence-sync.service
Wants=network-online.target
Before=hotel-business-snapshot.service

[Service]
Type=oneshot
User=ctrip-monitor
WorkingDirectory=/opt/hotel-ota-monitor
TimeoutStartSec=20min
Environment=TZ=Asia/Shanghai
EnvironmentFile=/var/lib/ctrip-monitor/.hotel_agent/db.env
EnvironmentFile=/var/lib/ctrip-monitor/.hotel_agent/qwen-search.env
ExecStart=/usr/bin/flock -w 300 /tmp/hotel-event-refresh.lock /opt/hotel-ota-monitor/.venv/bin/python /opt/hotel-ota-monitor/main.py event-forward-discovery --days 90
