[Unit]
Description=Generate Hotel Weekly Review
After=network-online.target hotel-daily-final-occupancy.service
Wants=network-online.target

[Service]
Type=oneshot
User=ctrip-monitor
WorkingDirectory=/opt/hotel-ota-monitor
Environment=TZ=Asia/Shanghai
EnvironmentFile=/var/lib/ctrip-monitor/.hotel_agent/db.env
EnvironmentFile=/var/lib/ctrip-monitor/.hotel_agent/webhook.env
TimeoutStartSec=35min
ExecStart=/usr/bin/flock -n /tmp/hotel-weekly-review.lock /opt/hotel-ota-monitor/.venv/bin/python /opt/hotel-ota-monitor/main.py weekly-review --auto-last-week --hotel-key all --no-dry-run --write-db --require-complete-final
